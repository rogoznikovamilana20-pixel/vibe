# Vibe — конфигурация окружения (НЕ коммитить реальные значения)
#
# Значения передаются флагами --dart-define при запуске/сборке:
#   flutter run --dart-define=SUPABASE_URL=<url> --dart-define=SUPABASE_ANON_KEY=<anon-key>
#
# SUPABASE_URL — https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY — publishable (anon) ключ проекта Supabase